<Page
    x:Class="Prueba3D.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid x:Name="RootGrid">

        <!-- Área extendida de la barra de título (transparente) -->
        <Grid x:Name="TitleBarArea"
              Background="Transparent"
              Height="32"/> <!-- Ajusta según el tamaño deseado -->

        <!-- Contenedor principal del juego o contenido -->
        <SwapChainPanel x:Name="GamePanel"
                        Margin="0,32,0,0"  <!-- Deja espacio para TitleBarArea -->
                        Background="Black"/>
    </Grid>
</Page>