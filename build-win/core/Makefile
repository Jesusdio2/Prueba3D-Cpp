	cd /Users/Francisco/AndroidStudioProjects/Prueba3D-Cpp/build-win && $(MAKE) $(MAKESILENT) -f core/CMakeFiles/core.dir/build.make core/CMakeFiles/core.dir/splash/splash_texture.cpp.i
.PHONY : splash/splash_texture.cpp.i

splash/splash_texture.s: splash/splash_texture.cpp.s
.PHONY : splash/splash_texture.s

